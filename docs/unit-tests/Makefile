# Build unit-tests.pdf: make -C docs/unit-tests
# (pdflatex, bibtex, pdflatex, pdflatex; unit-tests.bib can be regenerated by adstex)
unit-tests.pdf: unit-tests.tex unit-tests.bib
	pdflatex -interaction=nonstopmode -halt-on-error unit-tests.tex >/dev/null
	bibtex unit-tests >/dev/null
	pdflatex -interaction=nonstopmode -halt-on-error unit-tests.tex >/dev/null
	pdflatex -interaction=nonstopmode -halt-on-error unit-tests.tex >/dev/null

clean:
	rm -f unit-tests.aux unit-tests.log unit-tests.out unit-tests.toc unit-tests.pdf unit-tests.bbl unit-tests.blg
